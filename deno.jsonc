{
  "tasks": {
    "build": "silverbullet plug:compile --config deno.jsonc --dist ./dist/ ./history.plug.yaml",
    "dev": "silverbullet plug:compile --config deno.jsonc --dist ./dist/ --debug ./history.plug.yaml",
    "watch": "silverbullet plug:compile --config deno.jsonc --dist ./dist/ --debug --watch ./history.plug.yaml",
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "fmt": {
    "exclude": [
      "*.md",
      "**/*.md",
      "*.plug.js"
    ]
  },
  "imports": {
    "@silverbulletmd/silverbullet": "jsr:@silverbulletmd/silverbullet@^0.10.4"
  }
}
